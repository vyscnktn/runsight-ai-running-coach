# Environment for a self-hosted n8n instance (Docker). None of these are secrets
# except N8N_ENCRYPTION_KEY - generate your own and keep a backup.
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com
N8N_PROXY_HOPS=1
N8N_ENCRYPTION_KEY=change-me
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# API credentials (Strava, Telegram, Google, Notion, OpenAI, Gemini, Pinecone) are
# created inside the n8n UI and stored encrypted by n8n. Do not put them in git.
